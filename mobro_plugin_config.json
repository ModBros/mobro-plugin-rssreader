{
  "name": "modbros_rssreader",
  "displayName": "RSS Reader",
  "author": "ModBros",
  "description": "Display the latest items from up to 3 RSS feeds",
  "assembly": "Plugin.RssReader.dll",
  "localization": "Resources/Localization",
  "repository": null,
  "homepage": null,
  "tags": [
    "rss",
    "news",
    "feed"
  ],
  "dependencies": [],
  "settings": [
    {
      "type": "string",
      "name": "feed_url_1",
      "label": "setting.feed_url_1.label",
      "description": "setting.feed_url_1.desc",
      "required": true
    },
    {
      "type": "string",
      "name": "feed_name_1",
      "label": "setting.feed_name_1.label",
      "description": "setting.feed_name_1.desc",
      "defaultValue": "Feed 1",
      "required": false
    },
    {
      "type": "string",
      "name": "feed_url_2",
      "label": "setting.feed_url_2.label",
      "description": "setting.feed_url_2.desc",
      "required": false
    },
    {
      "type": "string",
      "name": "feed_name_2",
      "label": "setting.feed_name_2.label",
      "description": "setting.feed_name_2.desc",
      "defaultValue": "Feed 2",
      "required": false
    },
    {
      "type": "string",
      "name": "feed_url_3",
      "label": "setting.feed_url_3.label",
      "description": "setting.feed_url_3.desc",
      "required": false
    },
    {
      "type": "string",
      "name": "feed_name_3",
      "label": "setting.feed_name_3.label",
      "description": "setting.feed_name_3.desc",
      "defaultValue": "Feed 3",
      "required": false
    },
    {
      "type": "number",
      "name": "item_count",
      "label": "setting.item_count.label",
      "description": "setting.item_count.desc",
      "required": true,
      "defaultValue": 5,
      "min": 1,
      "max": 20
    },
    {
      "type": "number",
      "name": "update_frequency",
      "label": "setting.update_frequency.label",
      "description": "setting.update_frequency.desc",
      "required": true,
      "defaultValue": 30,
      "min": 5
    }
  ]
}
